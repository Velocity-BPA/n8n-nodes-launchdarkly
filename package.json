{
  "name": "@velocity-bpa/n8n-nodes-launchdarkly",
  "version": "1.0.0",
  "description": "n8n community node for LaunchDarkly API integration",
  "license": "bsl-catalog",
  "homepage": "https://github.com/velocity-bpa/n8n-nodes-launchdarkly",
  "author": {
    "name": "Velocity BPA",
    "email": "info@velocitybpa.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/velocity-bpa/n8n-nodes-launchdarkly.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.1.4",
  "main": "dist/index.js",
  "files": [
    "dist/**/*"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/LaunchDarklyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/LaunchDarkly/LaunchDarkly.node.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "prettier --write .",
    "lint": "eslint nodes credentials --ext .ts",
    "lintfix": "eslint nodes credentials --ext .ts --fix",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n-node",
    "launchdarkly",
    "feature-flags",
    "experiments",
    "api"
  ],
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.56.0",
    "n8n-workflow": "*",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}